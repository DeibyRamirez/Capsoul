rules_version = '2';

// Capsoul - Reglas de seguridad de Cloud Firestore (Sprint 2).
// Denegar por defecto. Solo usuarios/{uid} está abierto, y solo a su dueño.
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      function esDueno() {
        return request.auth != null && request.auth.uid == uid;
      }

      function nombreVisibleValido(datos) {
        return datos.nombreVisible is string
          && datos.nombreVisible.size() > 0
          && datos.nombreVisible.size() <= 60;
      }

      allow read: if esDueno();

      allow create: if esDueno()
        && request.resource.data.keys().hasOnly(
             ['nombreVisible', 'correo', 'fotoUrl', 'creadoEn'])
        && request.resource.data.keys().hasAll(
             ['nombreVisible', 'correo', 'creadoEn'])
        && nombreVisibleValido(request.resource.data)
        && request.resource.data.correo is string
        && request.resource.data.get('fotoUrl', null) == null
        && request.resource.data.creadoEn == request.time;

      allow update: if esDueno()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombreVisible'])
        && nombreVisibleValido(request.resource.data);

      // Borrar la cuenta está fuera del alcance del Sprint 2.
      allow delete: if false;
    }

    // Todo lo demás queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
